# Copy to slurm/site.env and edit. Everything cluster-specific lives here; recipes stay portable.
# slurm/site.env is git-ignored.

# ---- Slurm accounting -------------------------------------------------------------------------
export SLURM_PARTITION="gpu"          # sbatch --partition (empty = cluster default)
export SLURM_ACCOUNT=""               # sbatch --account  (empty = omit)
export SLURM_QOS=""                   # sbatch --qos      (empty = omit)
export GPUS_PER_NODE=8
export CPUS_PER_NODE=96               # CPUs given to Ray on every node (sbatch --cpus-per-task)
export MEM_PER_NODE=""                # e.g. 900G; empty = omit (many sites want --mem=0 for exclusive nodes)

# ---- Python environment (must have verl deps from third_party/verl, plus `pip install -e .` of this repo)
# Example: source /path/to/venv/bin/activate   or   module load cuda/12.4 && conda activate verl
rlx_activate_env() {
  :
  # source "$HOME/venvs/verl/bin/activate"
}

# ---- Assets (use absolute paths on a shared filesystem; compute nodes are usually offline) -------
export MODEL_PATH="/shared/models/Qwen3-8B"
export TRAIN_FILES="['/shared/data/train.parquet']"   # Hydra list syntax
export VAL_FILES="['/shared/data/val.parquet']"
export RUN_ROOT="$HOME/rlx_runs"                      # logs, checkpoints, snapshots per submission

# ---- Offline-friendly defaults ---------------------------------------------------------------
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export WANDB_MODE="${WANDB_MODE:-offline}"            # online | offline | disabled
export TRAINER_LOGGER='["console","wandb"]'

# ---- Network / NCCL (tune for your fabric; harmless if unused) -------------------------------------
# export NCCL_IB_HCA=mlx5
# export NCCL_SOCKET_IFNAME=ib0
# export GLOO_SOCKET_IFNAME=ib0
export NCCL_DEBUG=WARN
export TOKENIZERS_PARALLELISM=true
